# Discord — https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register guild commands instantly (recommended). Leave blank for global.
DISCORD_GUILD_ID=

# Google Sheets via Apps Script webhook (no service-account keys needed)
# Deploy google-apps-script/Code.gs as a Web App, then paste the URL here
SHEETS_WEBHOOK_URL=
# Must match WEBHOOK_SECRET inside the Apps Script
SHEETS_WEBHOOK_SECRET=change-me-to-a-long-random-string

# Optional overrides
PASSWORD_TTL_MINUTES=20
CHECKOUT_KEY_TTL_MINUTES=15
# Calendar day for early-leave / meeting-day labels (IANA timezone)
TEAM_TIMEZONE=America/Chicago
